<Window x:Class="FMOptimize.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:FMOptimize.ViewModels"
        xmlns:conv="clr-namespace:FMOptimize.Converters"
        xmlns:controls="clr-namespace:FMOptimize.Controls"
        mc:Ignorable="d"
        Title="FM Optimize"
        Width="1200" Height="800"
        MinWidth="900" MinHeight="500"
        Style="{StaticResource DarkWindowStyle}"
        WindowStartupLocation="CenterScreen"
        x:Name="ThisWindow"
        d:DataContext="{d:DesignInstance vm:MainViewModel}">
    <Window.Resources>
        <conv:IndexToDelayConverter x:Key="IndexToDelay"/>
    </Window.Resources>

    <Grid Background="{StaticResource BgPrimaryBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <controls:SidebarControl Grid.Column="0"
            IsDashboard="{Binding IsDashboard}"
            IsTweaks="{Binding IsTweaks}"
            IsUtilities="{Binding IsUtilities}"
            IsCleaner="{Binding IsCleaner}"
            IsRestorePoints="{Binding IsRestorePoints}"
            IsDnsManager="{Binding IsDnsManager}"
            IsApps="{Binding IsApps}"
            IsSettings="{Binding IsSettings}"
            NavigateToDashboardCommand="{Binding NavigateToDashboardCommand}"
            NavigateToTweaksCommand="{Binding NavigateToTweaksCommand}"
            NavigateToUtilitiesCommand="{Binding NavigateToUtilitiesCommand}"
            NavigateToCleanerCommand="{Binding NavigateToCleanerCommand}"
            NavigateToRestorePointsCommand="{Binding NavigateToRestorePointsCommand}"
            NavigateToDnsManagerCommand="{Binding NavigateToDnsManagerCommand}"
            NavigateToAppsCommand="{Binding NavigateToAppsCommand}"
            NavigateToSettingsCommand="{Binding NavigateToSettingsCommand}"/>

        <GridSplitter Grid.Column="1" Width="4" Background="Transparent"
                      HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext"/>

        <Grid Grid.Column="2" Background="{StaticResource BgPrimaryBrush}">
            <Rectangle Grid.RowSpan="3" Fill="{StaticResource BgGridTexture}" Opacity="0.15"/>
            <controls:CircuitBackground/>

            <!-- Scripts View (Tweaks, Utilities, Cleaner, DNS Manager, Apps) -->
            <Grid x:Name="ScriptsGrid">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentSection}" Value="Tweaks">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CurrentSection}" Value="Utilities">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CurrentSection}" Value="Cleaner">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CurrentSection}" Value="DNS Manager">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CurrentSection}" Value="Apps">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <controls:TopBarControl Grid.Row="0" x:Name="TopBar"
                    SelectedCategory="{Binding CurrentSection}"
                    ScriptCount="{Binding FilteredScripts.Count}"
                    SearchText="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              Padding="8,8,8,0"
                              Background="Transparent">
                    <ItemsControl ItemsSource="{Binding FilteredScripts}"
                                  x:Name="CardsGrid">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"
                                           ItemWidth="292"
                                           Margin="-6,0,0,0"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <controls:ScriptCardControl
                                    Script="{Binding}"
                                    ToggleFavoritoCommand="{Binding DataContext.ToggleFavoritoCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                    ShowDetailsCommand="{Binding DataContext.ShowDetailsCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                    ExecuteScriptCommand="{Binding DataContext.ExecuteScriptCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                    OpenEditDialogCommand="{Binding DataContext.OpenEditDialogCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                    RemoveScriptCommand="{Binding DataContext.RemoveScriptCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                    CancelScriptCommand="{Binding DataContext.CancelScriptCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <controls:LogPanelControl Grid.Row="2"
                    LogEntries="{Binding LogEntries}"
                    LogExpanded="{Binding LogExpanded}"
                    CopyLogCommand="{Binding CopyLogCommand}"
                    ClearLogCommand="{Binding ClearLogCommand}"
                    ToggleLogCommand="{Binding ToggleLogCommand}"/>
            </Grid>

            <!-- Dashboard View -->
            <controls:DashboardControl
                Visibility="{Binding DataContext.IsDashboard, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource BoolToVis}}"
                DataContext="{Binding DashboardData}"/>

            <!-- Restore Points View -->
            <controls:RestorePointsControl
                Visibility="{Binding IsRestorePoints, Converter={StaticResource BoolToVis}}"/>

            <!-- Settings View -->
            <controls:SettingsControl
                Visibility="{Binding IsSettings, Converter={StaticResource BoolToVis}}"/>
        </Grid>
    </Grid>
</Window>
