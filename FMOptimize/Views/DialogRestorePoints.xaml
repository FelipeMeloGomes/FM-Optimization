<Window x:Class="FMOptimize.DialogRestorePoints"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:FMOptimize.Models"
        Title="Pontos de Restauração"
        Width="780" Height="560"
        MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource FontUI}"
        MouseDown="Window_MouseDown"
        x:Name="ThisWindow">
    <Window.RenderTransform>
        <ScaleTransform ScaleX="1" ScaleY="1"/>
    </Window.RenderTransform>
    <Window.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.25"/>
                    <DoubleAnimation Storyboard.TargetProperty="(Window.RenderTransform).(ScaleTransform.ScaleX)"
                                     From="0.92" To="1" Duration="0:0:0.25">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetProperty="(Window.RenderTransform).(ScaleTransform.ScaleY)"
                                     From="0.92" To="1" Duration="0:0:0.25">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
    <Grid>
        <Border Background="#0a0a1e" CornerRadius="12" Opacity="0.95"/>
        <Border Background="{StaticResource BgGridTexture}" CornerRadius="12" Opacity="0.3"/>
        <Border BorderBrush="{StaticResource BorderDefaultBrush}"
                BorderThickness="1" CornerRadius="12"/>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="💾 PONTOS DE RESTAURAÇÃO"
                           FontSize="20" FontWeight="Bold"
                           FontFamily="{StaticResource FontUIBold}"
                           Foreground="{StaticResource NeonBlueBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" x:Name="TxtCount"
                           FontSize="13" FontWeight="Bold"
                           FontFamily="{StaticResource FontUIBold}"
                           Foreground="{StaticResource TextMutedBrush}"
                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                <Button Grid.Column="2" Content="✕" Width="30" Height="30"
                        Style="{StaticResource GhostButton}"
                        Foreground="{StaticResource TextMutedBrush}"
                        FontSize="16"
                        Click="CloseClick"/>
            </Grid>

            <!-- Status / Loading -->
            <Border Grid.Row="1" x:Name="StatusBar" CornerRadius="6"
                    Background="{StaticResource BgCardBrush}"
                    BorderBrush="{StaticResource BorderDefaultBrush}"
                    BorderThickness="1"
                    Padding="12,6" Margin="0,0,0,4"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="TxtStatusIcon" FontSize="14"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Grid.Column="1" x:Name="TxtStatusMessage"
                             FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                             Background="Transparent" BorderThickness="0"
                             TextWrapping="Wrap" VerticalAlignment="Center"
                             IsReadOnly="True"
                             CaretBrush="{StaticResource NeonBlueLightBrush}"/>
                </Grid>
            </Border>

            <!-- Table Header -->
            <Border Grid.Row="2" CornerRadius="8"
                    Background="{StaticResource BgElevatedBrush}"
                    BorderBrush="{StaticResource BorderDefaultBrush}"
                    BorderThickness="1"
                    Padding="12,6" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="90"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="#" FontSize="11" FontWeight="Bold"
                               FontFamily="{StaticResource FontUIBold}"
                               Foreground="{StaticResource NeonBlueLightBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Descrição"
                               FontSize="11" FontWeight="Bold" FontFamily="{StaticResource FontUIBold}"
                               Foreground="{StaticResource NeonBlueLightBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="Data de Criação"
                               FontSize="11" FontWeight="Bold" FontFamily="{StaticResource FontUIBold}"
                               Foreground="{StaticResource NeonBlueLightBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="Tipo"
                               FontSize="11" FontWeight="Bold" FontFamily="{StaticResource FontUIBold}"
                               Foreground="{StaticResource NeonBlueLightBrush}"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- List -->
            <Border Grid.Row="3" CornerRadius="8"
                    Background="{StaticResource BgCardBrush}"
                    BorderBrush="{StaticResource BorderDefaultBrush}"
                    BorderThickness="1">
                <Grid>
                    <ListBox x:Name="ListaRestores"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             SelectionChanged="ListaRestores_SelectionChanged"
                             Padding="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:RestorePointEntry}">
                                <Border Padding="8,6" BorderBrush="{StaticResource BorderDefaultBrush}"
                                        BorderThickness="0,0,0,1"
                                        Background="Transparent">
                                    <Border.ContextMenu>
                                        <ContextMenu Background="{StaticResource BgCardBrush}"
                                                     BorderBrush="{StaticResource BorderDefaultBrush}"
                                                     BorderThickness="1"
                                                     Foreground="{StaticResource TextPrimaryBrush}"
                                                     FontFamily="{StaticResource FontUI}"
                                                     FontSize="13">
                                            <MenuItem Header="Copiar descrição"
                                                      Click="CopyItemClick">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="📋" FontSize="12"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Copiar tudo"
                                                      Click="CopyItemFullClick">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="📋" FontSize="12"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="90"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding SequenceNumber}"
                                                   FontSize="11" Foreground="{StaticResource TextDimBrush}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Descricao}"
                                                   FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding DataCriacao}"
                                                   FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                                   VerticalAlignment="Center"
                                                   FontFamily="{StaticResource FontMono}"/>
                                        <Border Grid.Column="3" Padding="6,2" CornerRadius="3"
                                                Background="#001a33"
                                                BorderBrush="{StaticResource NeonBlueBrush}"
                                                BorderThickness="1"
                                                HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Tipo}" FontSize="10" FontWeight="Bold"
                                                       Foreground="{StaticResource NeonBlueBrush}"
                                                       FontFamily="{StaticResource FontUIBold}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgElevatedBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#0d1a3d"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                    <TextBlock x:Name="TxtEmpty"
                               FontSize="13" Foreground="{StaticResource TextDimBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="Collapsed"
                               Text="Nenhum ponto de restauração encontrado."/>
                </Grid>
            </Border>

            <!-- Action Buttons -->
            <Border Grid.Row="4" Margin="0,12,0,0" Padding="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" x:Name="BtnRestaurar"
                            Height="32" Padding="14,0"
                            Style="{StaticResource OutlineButton}"
                            FontSize="12"
                            IsEnabled="False"
                            Click="RestoreClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="↩" FontSize="13" Margin="0,0,6,0"/>
                            <TextBlock Text="Restaurar"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="1" x:Name="BtnExcluir"
                            Height="32" Padding="14,0" Margin="6,0,0,0"
                            FontSize="12"
                            IsEnabled="False"
                            Click="DeleteClick">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource OutlineButton}">
                                <Setter Property="Foreground" Value="{StaticResource RedErrorBrush}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource RedErrorBrush}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#33ff1744"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderDefaultBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✕" FontSize="13" Margin="0,0,6,0"/>
                            <TextBlock Text="Excluir"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="2" x:Name="BtnCopiar"
                            Height="32" Padding="14,0" Margin="6,0,0,0"
                            Style="{StaticResource OutlineButton}"
                            FontSize="12"
                            IsEnabled="False"
                            Click="CopyClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋" FontSize="13" Margin="0,0,6,0"/>
                            <TextBlock Text="Copiar"/>
                        </StackPanel>
                    </Button>

                    <Grid Grid.Column="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="TxtSelectedInfo"
                                   Grid.Row="0"
                                   FontSize="11" Foreground="{StaticResource TextDimBrush}"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <Button Grid.Column="6" Content="Fechar"
                            Style="{StaticResource SmallIconButton}"
                            Width="90" Height="32"
                            Foreground="{StaticResource TextMutedBrush}"
                            FontSize="13"
                            Click="CloseClick"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
