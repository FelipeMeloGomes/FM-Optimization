<UserControl x:Class="FMOptimize.Controls.SettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="900">
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="24,16" BorderBrush="{StaticResource BorderDefaultBrush}"
                BorderThickness="0,0,0,1" Background="Transparent">
            <TextBlock Text="SETTINGS"
                       FontSize="22" FontWeight="Bold"
                       FontFamily="{StaticResource FontUIBold}"
                       Foreground="{StaticResource NeonBlueBrush}"
                       VerticalAlignment="Center"/>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Padding="24,20" Background="Transparent">
            <StackPanel>
                <!-- About -->
                <Border CornerRadius="10" Padding="20"
                        Background="{StaticResource BgCardBrush}"
                        BorderBrush="{StaticResource BorderDefaultBrush}"
                        BorderThickness="1"
                        Effect="{StaticResource CardShadow}"
                        Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <TextBlock Text="FM" FontSize="22" FontWeight="Bold"
                                       FontFamily="{StaticResource FontLogo}"
                                       Foreground="{StaticResource NeonBlueBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text=" OPTIMIZE" FontSize="18" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" Margin="4,0,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Margin="0,6,0,0"
                                   Text="Ferramenta de otimização e manutenção do Windows. Execute scripts de limpeza, ajustes de desempenho, gerenciamento de DNS e muito mais."
                                   FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                   TextWrapping="Wrap"/>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
