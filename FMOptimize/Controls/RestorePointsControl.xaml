<UserControl x:Class="FMOptimize.Controls.RestorePointsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:models="clr-namespace:FMOptimize.Models"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="900">
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="24,16" BorderBrush="{StaticResource BorderDefaultBrush}"
                BorderThickness="0,0,0,1" Background="Transparent">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="RESTORE POINTS"
                           FontSize="22" FontWeight="Bold"
                           FontFamily="{StaticResource FontUIBold}"
                           Foreground="{StaticResource NeonBlueBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" x:Name="TxtCount"
                           FontSize="13" FontWeight="Bold"
                           FontFamily="{StaticResource FontUIBold}"
                           Foreground="{StaticResource TextMutedBrush}"
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                <Button Grid.Column="2" Height="32" MinWidth="110"
                        Command="{Binding CreateBackupCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource OutlineButton}">
                            <Setter Property="Content" Value="⬇ Criar Backup"/>
                            <Setter Property="IsEnabled" Value="True"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                    <Setter Property="Content" Value="⏳ Backup..."/>
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!-- Status -->
        <Border Grid.Row="1" x:Name="StatusBar" CornerRadius="6" Margin="24,8,24,0"
                Background="{StaticResource BgCardBrush}"
                BorderBrush="{StaticResource BorderDefaultBrush}"
                BorderThickness="1"
                Padding="12,6"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="TxtStatusIcon" FontSize="14"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="1" x:Name="TxtStatusMessage"
                           FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                           TextWrapping="Wrap" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Loading -->
        <Border Grid.Row="2" Margin="24,8,24,0" Padding="12,6"
                Background="{StaticResource BgCardBrush}"
                BorderBrush="{StaticResource BorderDefaultBrush}"
                BorderThickness="1" CornerRadius="6"
                Visibility="{Binding IsOperatingRestore, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Carregando pontos de restauração..."
                       FontSize="13" Foreground="{StaticResource TextMutedBrush}"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- Table Header -->
        <Border Grid.Row="2" CornerRadius="8" Margin="24,8,24,0"
                Background="{StaticResource BgElevatedBrush}"
                BorderBrush="{StaticResource BorderDefaultBrush}"
                BorderThickness="1"
                Padding="12,6"
                Visibility="{Binding IsOperatingRestore, Converter={StaticResource InverseBoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="#" FontSize="11" FontWeight="Bold"
                           FontFamily="{StaticResource FontUIBold}"
                           Foreground="{StaticResource NeonBlueLightBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Descrição"
                           FontSize="11" FontWeight="Bold" FontFamily="{StaticResource FontUIBold}"
                           Foreground="{StaticResource NeonBlueLightBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="Data de Criação"
                           FontSize="11" FontWeight="Bold" FontFamily="{StaticResource FontUIBold}"
                           Foreground="{StaticResource NeonBlueLightBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="3" Text="Tipo"
                           FontSize="11" FontWeight="Bold" FontFamily="{StaticResource FontUIBold}"
                           Foreground="{StaticResource NeonBlueLightBrush}"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Restore Points List -->
        <Border Grid.Row="3" CornerRadius="8" Margin="24,4,24,0"
                Background="{StaticResource BgCardBrush}"
                BorderBrush="{StaticResource BorderDefaultBrush}"
                BorderThickness="1"
                x:Name="ListBorder">
            <Grid>
                <ListBox x:Name="ListaRestores"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ItemsSource="{Binding RestorePoints}"
                         SelectedItem="{Binding SelectedRestorePoint, Mode=TwoWay}"
                         Padding="0"
                         Visibility="{Binding IsOperatingRestore, Converter={StaticResource InverseBoolToVis}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:RestorePointEntry}">
                            <Border Padding="8,6" BorderBrush="{StaticResource BorderDefaultBrush}"
                                    BorderThickness="0,0,0,1"
                                    Background="Transparent">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding SequenceNumber}"
                                               FontSize="11" Foreground="{StaticResource TextDimBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Descricao}"
                                               FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding DataCriacao}"
                                               FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                               VerticalAlignment="Center"
                                               FontFamily="{StaticResource FontMono}"/>
                                    <Border Grid.Column="3" Padding="6,2" CornerRadius="3"
                                            Background="#001a33"
                                            BorderBrush="{StaticResource NeonBlueBrush}"
                                            BorderThickness="1"
                                            HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Tipo}" FontSize="10" FontWeight="Bold"
                                                   Foreground="{StaticResource NeonBlueBrush}"
                                                   FontFamily="{StaticResource FontUIBold}"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgElevatedBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#0d1a3d"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
                <TextBlock x:Name="TxtEmpty"
                           FontSize="13" Foreground="{StaticResource TextDimBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="Collapsed"
                           Text="Nenhum ponto de restauração encontrado."/>
            </Grid>
        </Border>

        <!-- Actions -->
        <Border Grid.Row="4" Margin="24,8,24,16" Padding="0" Background="Transparent">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" x:Name="BtnRestaurar"
                        Height="32" Padding="14,0"
                        Style="{StaticResource OutlineButton}"
                        FontSize="12"
                        Command="{Binding RestoreRestorePointCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="↩" FontSize="13" Margin="0,0,6,0"/>
                        <TextBlock Text="Restaurar"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="1" x:Name="BtnExcluir"
                        Height="32" Padding="14,0" Margin="6,0,0,0"
                        FontSize="12" Command="{Binding DeleteRestorePointCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource OutlineButton}">
                            <Setter Property="Foreground" Value="{StaticResource RedErrorBrush}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource RedErrorBrush}"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#33ff1744"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource BorderDefaultBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✕" FontSize="13" Margin="0,0,6,0"/>
                        <TextBlock Text="Excluir"/>
                    </StackPanel>
                </Button>

                <TextBlock Grid.Column="3" x:Name="TxtSelectedInfo"
                           FontSize="11" Foreground="{StaticResource TextDimBrush}"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
