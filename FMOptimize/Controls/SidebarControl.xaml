<UserControl x:Class="FMOptimize.Controls.SidebarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="200">
    <UserControl.Resources>
        <Style x:Key="SidebarItemStyle" TargetType="Border">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1a1a3e"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource SidebarGradient}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Height="52" BorderBrush="{StaticResource BorderDefaultBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel VerticalAlignment="Center" Margin="16,0,0,0">
                <TextBlock Text="FM" FontSize="24" FontWeight="Bold"
                           FontFamily="{StaticResource FontLogo}"
                           Foreground="{StaticResource NeonBlueBrush}" Height="26"/>
                <TextBlock Text="OPTIMIZE" FontSize="10" FontWeight="Bold"
                           Foreground="{StaticResource NeonBlueLightBrush}"
                           FontFamily="{StaticResource FontUIBold}"
                           Margin="0,-2,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="Transparent">
            <StackPanel>
                <!-- Dashboard -->
                <Border Style="{StaticResource SidebarItemStyle}" x:Name="DashboardBtn">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick"
                                      Command="{Binding NavigateToDashboardCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"/>
                    </Border.InputBindings>
                    <Grid Margin="20,0,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Width="16" Height="16" Stretch="Uniform"
                              Fill="{StaticResource TextMutedBrush}" Margin="0,0,10,0"
                              Data="{Binding DashboardIcon, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                              VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Dashboard" FontSize="13"
                                   Foreground="{StaticResource NeonBlueBrush}"
                                   VerticalAlignment="Center" FontWeight="Bold"/>
                    </Grid>
                </Border>

                <!-- Tweaks -->
                <Border Style="{StaticResource SidebarItemStyle}" x:Name="TweaksBtn">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick"
                                      Command="{Binding NavigateToTweaksCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"/>
                    </Border.InputBindings>
                    <Grid Margin="20,0,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Width="16" Height="16" Stretch="Uniform"
                              Fill="{StaticResource TextMutedBrush}" Margin="0,0,10,0"
                              Data="{Binding TweaksIcon, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                              VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Tweaks" FontSize="13"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <!-- Utilities -->
                <Border Style="{StaticResource SidebarItemStyle}" x:Name="UtilitiesBtn">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick"
                                      Command="{Binding NavigateToUtilitiesCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"/>
                    </Border.InputBindings>
                    <Grid Margin="20,0,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Width="16" Height="16" Stretch="Uniform"
                              Fill="{StaticResource TextMutedBrush}" Margin="0,0,10,0"
                              Data="{Binding UtilitiesIcon, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                              VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Utilities" FontSize="13"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <!-- Cleaner -->
                <Border Style="{StaticResource SidebarItemStyle}" x:Name="CleanerBtn">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick"
                                      Command="{Binding NavigateToCleanerCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"/>
                    </Border.InputBindings>
                    <Grid Margin="20,0,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Width="16" Height="16" Stretch="Uniform"
                              Fill="{StaticResource TextMutedBrush}" Margin="0,0,10,0"
                              Data="{Binding CleanerIcon, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                              VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Cleaner" FontSize="13"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Restore Points -->
                <Border Style="{StaticResource SidebarItemStyle}" x:Name="RestorePointsBtn">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick"
                                      Command="{Binding NavigateToRestorePointsCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"/>
                    </Border.InputBindings>
                    <Grid Margin="20,0,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Width="16" Height="16" Stretch="Uniform"
                              Fill="{StaticResource TextMutedBrush}" Margin="0,0,10,0"
                              Data="{Binding RestorePointsIcon, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                              VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Restore Points" FontSize="13"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <!-- DNS Manager -->
                <Border Style="{StaticResource SidebarItemStyle}" x:Name="DnsManagerBtn">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick"
                                      Command="{Binding NavigateToDnsManagerCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"/>
                    </Border.InputBindings>
                    <Grid Margin="20,0,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Width="16" Height="16" Stretch="Uniform"
                              Fill="{StaticResource TextMutedBrush}" Margin="0,0,10,0"
                              Data="{Binding DnsManagerIcon, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                              VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="DNS Manager" FontSize="13"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <!-- Apps -->
                <Border Style="{StaticResource SidebarItemStyle}" x:Name="AppsBtn">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick"
                                      Command="{Binding NavigateToAppsCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"/>
                    </Border.InputBindings>
                    <Grid Margin="20,0,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Width="16" Height="16" Stretch="Uniform"
                              Fill="{StaticResource TextMutedBrush}" Margin="0,0,10,0"
                              Data="{Binding AppsIcon, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                              VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Apps" FontSize="13"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Settings (pinned to bottom) -->
        <Border Grid.Row="2" Style="{StaticResource SidebarItemStyle}" x:Name="SettingsBtn"
                BorderBrush="{StaticResource BorderDefaultBrush}"
                BorderThickness="0,1,0,0">
            <Border.InputBindings>
                <MouseBinding MouseAction="LeftClick"
                              Command="{Binding NavigateToSettingsCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"/>
            </Border.InputBindings>
            <Grid Margin="20,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Path Grid.Column="0" Width="16" Height="16" Stretch="Uniform"
                      Fill="{StaticResource TextMutedBrush}" Margin="0,0,10,0"
                      Data="{Binding SettingsIcon, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                      VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Settings" FontSize="13"
                           Foreground="{StaticResource TextMutedBrush}"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
