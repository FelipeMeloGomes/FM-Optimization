<UserControl x:Class="FMOptimize.Controls.DashboardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:FMOptimize.Controls"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="900">
    <UserControl.Resources>
        <local:PctToStarConverter x:Key="PctToStar"/>
        <local:PctToStarOppositeConverter x:Key="PctToStarOpp"/>
        <local:StorageColorConverter x:Key="StorageColor"/>

        <Style x:Key="DashCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgCardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>

        <LinearGradientBrush x:Key="ProgressGreen" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#00e676" Offset="0"/>
            <GradientStop Color="#00c853" Offset="1"/>
        </LinearGradientBrush>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="24,16" BorderBrush="{StaticResource BorderDefaultBrush}"
                BorderThickness="0,0,0,1" Background="Transparent">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="DASHBOARD"
                           FontSize="22" FontWeight="Bold"
                           FontFamily="{StaticResource FontUIBold}"
                           Foreground="{StaticResource NeonBlueBrush}"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="●" FontSize="10"
                               Foreground="{StaticResource GreenRunBrush}"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding NomeUsuario}"
                               FontSize="16" FontWeight="Bold"
                               FontFamily="{StaticResource FontUIBold}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Padding="20,16,20,20" Background="Transparent">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- CPU Card -->
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource DashCard}" Padding="16" Margin="0,0,8,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <Path Width="20" Height="20" Stretch="Uniform"
                                  Fill="{StaticResource NeonBlueBrush}" VerticalAlignment="Center"
                                  Data="M4,2 L20,2 L20,4 L22,4 L22,14 L20,14 L20,18 L24,18 L24,20 L0,20 L0,18 L4,18 L4,14 L2,14 L2,4 L4,4 Z M6,4 L6,14 L18,14 L18,4 Z M8,6 L8,12 L16,12 L16,6 Z M8,16 L16,16 L16,18 L8,18 Z"/>
                            <TextBlock Text="CPU" FontSize="13" FontWeight="Bold" Margin="8,0,0,0"
                                       Foreground="{StaticResource NeonBlueLightBrush}"
                                       FontFamily="{StaticResource FontUIBold}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Margin="0,6,0,0">
                            <TextBlock Text="{Binding Cpu.Nome}" FontSize="12"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       TextWrapping="Wrap"/>
                            <TextBlock FontSize="11" Margin="0,4,0,0"
                                       Foreground="{StaticResource TextMutedBrush}">
                                <Run Text="{Binding Cpu.CoresFisicas}"/><Run Text=" físicos / "/><Run Text="{Binding Cpu.CoresLogicas}"/><Run Text=" lógicos"/>
                            </TextBlock>
                            <TextBlock Text="{Binding Cpu.Frequencia, StringFormat='Freq: {0}'}" FontSize="11"
                                       Foreground="{StaticResource TextDimBrush}"/>
                            <TextBlock Text="{Binding Cpu.Cache}" FontSize="11"
                                       Foreground="{StaticResource TextDimBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- GPU Card -->
                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource DashCard}" Padding="16" Margin="8,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <Path Width="20" Height="20" Stretch="Uniform"
                                  Fill="{StaticResource NeonBlueBrush}" VerticalAlignment="Center"
                                  Data="M4,2 L20,2 L20,6 L24,6 L24,18 L20,18 L20,22 L4,22 L4,18 L0,18 L0,6 L4,6 Z M6,4 L6,8 L18,8 L18,4 Z M2,8 L2,16 L4,16 L4,8 Z M20,8 L20,16 L22,16 L22,8 Z M6,14 L18,14 L18,16 L6,16 Z M6,18 L18,18 L18,20 L6,20 Z"/>
                            <TextBlock Text="GPU" FontSize="13" FontWeight="Bold" Margin="8,0,0,0"
                                       Foreground="{StaticResource NeonBlueLightBrush}"
                                       FontFamily="{StaticResource FontUIBold}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Margin="0,6,0,0">
                            <TextBlock Text="{Binding Gpu.Nome}" FontSize="12"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Gpu.Vram, StringFormat='VRAM: {0}'}" FontSize="11" Margin="0,4,0,0"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding Gpu.DriverVersao, StringFormat='Driver: {0}'}" FontSize="11"
                                       Foreground="{StaticResource TextDimBrush}"/>
                            <TextBlock FontSize="11" Foreground="{StaticResource TextDimBrush}">
                                <Run Text="{Binding Gpu.Resolucao}"/><Run Text=" @ "/><Run Text="{Binding Gpu.RefreshRate}"/>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Memory Card -->
                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource DashCard}" Padding="16" Margin="0,0,8,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <Path Width="20" Height="20" Stretch="Uniform"
                                  Fill="{StaticResource NeonBlueBrush}" VerticalAlignment="Center"
                                  Data="M2,4 L22,4 L22,20 L2,20 Z M4,6 L4,18 L20,18 L20,6 Z M8,8 L16,8 L16,10 L8,10 Z M8,12 L16,12 L16,14 L8,14 Z M8,16 L14,16 L14,18 L8,18 Z"/>
                            <TextBlock Text="MEMORY" FontSize="13" FontWeight="Bold" Margin="8,0,0,0"
                                       Foreground="{StaticResource NeonBlueLightBrush}"
                                       FontFamily="{StaticResource FontUIBold}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Margin="0,6,0,0">
                            <TextBlock Text="{Binding Memory.Total, StringFormat='Total: {0}'}" FontSize="12"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock FontSize="11" Margin="0,4,0,0"
                                       Foreground="{StaticResource TextMutedBrush}">
                                <Run Text="{Binding Memory.Usado}"/><Run Text=" usado / "/><Run Text="{Binding Memory.Livre}"/><Run Text=" livre"/>
                            </TextBlock>
                            <TextBlock Text="{Binding Memory.Slots, StringFormat='Slots: {0}'}" FontSize="11"
                                       Foreground="{StaticResource TextDimBrush}"/>
                            <Border Height="5" CornerRadius="2.5" Background="{StaticResource BgSurfaceBrush}" Margin="0,6,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding Memory.PercentualUso, Converter={StaticResource PctToStar}}"/>
                                        <ColumnDefinition Width="{Binding Memory.PercentualUso, Converter={StaticResource PctToStarOpp}}"/>
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Grid.Column="0" Fill="{StaticResource ProgressGreen}" RadiusX="2.5" RadiusY="2.5"/>
                                </Grid>
                            </Border>
                            <TextBlock Text="{Binding Memory.PercentualUso, StringFormat={}{0:F1}% em uso}"
                                       FontSize="10" Foreground="{StaticResource TextDimBrush}" Margin="0,1,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- System Card -->
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource DashCard}" Padding="16" Margin="8,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <Path Width="20" Height="20" Stretch="Uniform"
                                  Fill="{StaticResource NeonBlueBrush}" VerticalAlignment="Center"
                                  Data="M12,2 A4,4 0 1,1 12,10 A4,4 0 0,1 12,2 Z M5,18 L19,18 L20,22 L4,22 Z M8,14 L16,14 L16,16 L8,16 Z"/>
                            <TextBlock Text="SYSTEM" FontSize="13" FontWeight="Bold" Margin="8,0,0,0"
                                       Foreground="{StaticResource NeonBlueLightBrush}"
                                       FontFamily="{StaticResource FontUIBold}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Margin="0,6,0,0">
                            <TextBlock Text="{Binding System.VersaoWindows}" FontSize="12"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding System.Build, StringFormat='Build {0}'}" FontSize="11" Margin="0,4,0,0"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock FontSize="11" Foreground="{StaticResource TextDimBrush}">
                                <Run Text="{Binding System.NomePC}"/><Run Text=" • "/><Run Text="{Binding System.NomeUsuario}"/>
                            </TextBlock>
                            <TextBlock Text="{Binding System.Uptime, StringFormat='Ativo há {0}'}" FontSize="11"
                                       Foreground="{StaticResource TextDimBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Storage Card -->
                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource DashCard}" Padding="16" Margin="0,0,8,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <Path Width="20" Height="20" Stretch="Uniform"
                                  Fill="{StaticResource NeonBlueBrush}" VerticalAlignment="Center"
                                  Data="M2,4 L6,4 L6,20 L2,20 Z M6,6 L22,6 L22,18 L6,18 Z M8,8 L12,8 L12,10 L8,10 Z M14,8 L18,8 L18,10 L14,10 Z M8,12 L12,12 L12,14 L8,14 Z M14,12 L18,12 L18,14 L14,14 Z M8,16 L12,16 L12,18 L8,18 Z"/>
                            <TextBlock Text="STORAGE" FontSize="13" FontWeight="Bold" Margin="8,0,0,0"
                                       Foreground="{StaticResource NeonBlueLightBrush}"
                                       FontFamily="{StaticResource FontUIBold}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Storage}" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Letra}"
                                                       FontSize="12" FontWeight="Bold"
                                                       Foreground="{StaticResource NeonBlueLightBrush}"
                                                       VerticalAlignment="Center" MinWidth="24"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Rotulo}" FontSize="11"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="2" FontSize="10" FontWeight="Bold"
                                                       VerticalAlignment="Center" Margin="0,0,6,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="SSD"/>
                                                        <Setter Property="Foreground" Value="{StaticResource NeonBlueLightBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Tipo}" Value="HDD">
                                                                <Setter Property="Text" Value="HDD"/>
                                                                <Setter Property="Foreground" Value="{StaticResource OrangeWarnBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Tipo}" Value="NVMe">
                                                                <Setter Property="Text" Value="NVMe"/>
                                                                <Setter Property="Foreground" Value="{StaticResource GreenRunBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Grid.Column="3" FontSize="11"
                                                       Foreground="{StaticResource TextDimBrush}"
                                                       VerticalAlignment="Center">
                                                <Run Text="{Binding Usado}"/><Run Text="/"/><Run Text="{Binding Total}"/>
                                            </TextBlock>
                                        </Grid>
                                        <Border Height="4" CornerRadius="2"
                                                Background="{StaticResource BgSurfaceBrush}" Margin="0,3,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{Binding PercentualUso, Converter={StaticResource PctToStar}}"/>
                                                    <ColumnDefinition Width="{Binding PercentualUso, Converter={StaticResource PctToStarOpp}}"/>
                                                </Grid.ColumnDefinitions>
                                                <Rectangle Grid.Column="0" RadiusX="2" RadiusY="2"
                                                           Fill="{Binding PercentualUso, Converter={StaticResource StorageColor}}"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <!-- Tweaks Card -->
                <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource DashCard}" Padding="16" Margin="8,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <Path Width="20" Height="20" Stretch="Uniform"
                                  Fill="{StaticResource NeonBlueBrush}" VerticalAlignment="Center"
                                  Data="M12,2 A3,3 0 1,1 12,8 A3,3 0 0,1 12,2 Z M8,10 L16,10 L16,12 L8,12 Z M8,14 L16,14 L16,16 L8,16 Z M10,18 L14,18 L14,22 L10,22 Z"/>
                            <TextBlock Text="TWEAKS" FontSize="13" FontWeight="Bold" Margin="8,0,0,0"
                                       Foreground="{StaticResource NeonBlueLightBrush}"
                                       FontFamily="{StaticResource FontUIBold}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Tweaks}" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Nome}"
                                                   FontSize="11" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Grid.Column="1" FontSize="11" FontWeight="Bold"
                                                   FontFamily="{StaticResource FontUIBold}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource GreenRunBrush}"/>
                                                    <Setter Property="Text" Value="●"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Ativo}" Value="False">
                                                            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
                                                            <Setter Property="Text" Value="✗"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
